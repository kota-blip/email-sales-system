# このファイルをコピーして .env を作成し、実際の値を入れてください。
# .env は絶対にコミットしないでください（.gitignore 済み）。

# ===== LINE API（メール返信システム） =====
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_USER_ID=your_line_user_id

# ===== Claude API =====
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ===== Telegram API（請求書集計システムの通知・承認） =====
# BotFather (@BotFather) から取得したトークン
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 通知・承認を受け取るチャット/ユーザーID（@userinfobot 等で確認）
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== Google Sheets 連携（請求書集計システム） =====
# サービスアカウントJSONキーファイルのパス
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# 既存スプレッドシートを使う場合はIDを指定（未指定なら自動で新規作成）
GOOGLE_SPREADSHEET_ID=
# 新規作成時にスプレッドシートを共有する自分のGoogleアカウントメール
GOOGLE_SHEET_SHARE_EMAIL=your_google_account@example.com

# ===== 請求書集計システム 動作設定 =====
# Gmail監視の実行間隔（秒）。デフォルト1時間ごと
INVOICE_CHECK_INTERVAL=3600
# 請求書監視用WebhookサーバーのPort
INVOICE_WEBHOOK_PORT=5002
# 3点セット（見積書/納品書/請求書）を同一案件とみなす日数の許容幅
INVOICE_MATCH_WINDOW_DAYS=60
# 金額マッチングの許容誤差（0.15 = 15%）
INVOICE_MATCH_AMOUNT_TOLERANCE=0.15

# ===== 共通システム設定 =====
GMAIL_CHECK_INTERVAL=30
WEBHOOK_PORT=5000
MAX_EMAILS_PER_CHECK=5
